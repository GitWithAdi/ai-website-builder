{
  "name": "ai-website-builder",
  "version": "1.0.0",
  "description": "AI-Powered Website Generation Platform",
  "author": "Aditya Pratap <aditya.pratap2024b@vitstudent.ac.in>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run server --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=server/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=server/prisma/schema.prisma"
  }
}
